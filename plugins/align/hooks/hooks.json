{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @aligndottech/cli@0.83.2 check --advisory",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @aligndottech/cli@0.83.2 check --advisory",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
