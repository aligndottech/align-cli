{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @aligndottech/cli@latest check --advisory --format codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
