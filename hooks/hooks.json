{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "npx -y @aligndottech/cli@latest check --advisory", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "npx -y @aligndottech/cli@latest check --advisory", "timeout": 10 }]
      }
    ]
  }
}
