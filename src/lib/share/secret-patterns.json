{
  "case_insensitive": [
    [
      "([a-zA-Z][a-zA-Z0-9+.\\-]{0,31}://)[^/\\s:@]+:[^/\\s:@]+@",
      "\\1<URL_CREDENTIALS>@"
    ],
    [
      "(?<![\\w@.:/])[A-Za-z][\\w.\\-]{1,30}:(?![/\\s])(?!v?\\d[\\d.]*(?:-[a-z0-9][a-z0-9.\\-]*)?(?![^\\s:@/]))(?=[^\\s:@/]*[A-Za-z])(?=[^\\s:@/]*\\d)[^\\s:@/]{8,}",
      "<CREDENTIALS>"
    ],
    [
      "AKIA[0-9A-Z]{16}",
      "<AWS_ACCESS_KEY>"
    ],
    [
      "ghp_[a-zA-Z0-9]{36}",
      "<GITHUB_TOKEN>"
    ],
    [
      "github_pat_[a-zA-Z0-9]{22}_[a-zA-Z0-9]{59}",
      "<GITHUB_TOKEN>"
    ],
    [
      "sk-[a-zA-Z0-9]{48}",
      "<OPENAI_KEY>"
    ],
    [
      "sk-ant-[a-zA-Z0-9\\-]{95,}",
      "<ANTHROPIC_KEY>"
    ],
    [
      "(?<![A-Za-z0-9])eyJ(?:[A-Za-z0-9_\\-]|\\r?\\n){10,}(?:\\s*(?:\\.|%2E)\\s*(?:[A-Za-z0-9_\\-]|\\r?\\n){10,}){2}",
      "<JWT>"
    ],
    [
      "(?<![A-Za-z0-9])sk-(?=[A-Za-z0-9_\\-]*\\d)[A-Za-z0-9_\\-]{20,}",
      "<OPENAI_KEY>"
    ],
    [
      "(?<![A-Za-z0-9])[sr]k_(?:live|test)_[A-Za-z0-9]{16,}",
      "<STRIPE_KEY>"
    ],
    [
      "(?<![A-Za-z0-9])AIza[0-9A-Za-z_\\-]{35}",
      "<GOOGLE_API_KEY>"
    ],
    [
      "((?:aws[_\\-\\s]*secret(?:[_\\-\\s]*access)?(?:[_\\-\\s]*key)?|secret[_\\-\\s]*access[_\\-\\s]*key)[\\\"'\\s:=]+)[A-Za-z0-9/+]{40}(?![A-Za-z0-9/+])",
      "\\1<AWS_SECRET_KEY>"
    ],
    [
      "xox[baprs]-[0-9]{10,13}-[0-9]{10,13}-[a-zA-Z0-9]{24,}",
      "<SLACK_TOKEN>"
    ],
    [
      "(?<![A-Za-z0-9])xox[a-z](?:\\.xox[a-z])?-[A-Za-z0-9\\-]{20,}",
      "<SLACK_TOKEN>"
    ],
    [
      "(?<![A-Za-z0-9])lin_api_[A-Za-z0-9]{32,}",
      "<LINEAR_KEY>"
    ],
    [
      "(?<![A-Za-z0-9])gh[ousr]_[A-Za-z0-9]{36}",
      "<GITHUB_TOKEN>"
    ],
    [
      "(?<![A-Za-z0-9])glpat-[A-Za-z0-9_\\-]{20,}",
      "<GITLAB_TOKEN>"
    ],
    [
      "api[_-]?key[\"\\s:=]+[\"\\']?([a-zA-Z0-9_\\-]{20,})[\"\\']?",
      "<API_KEY>"
    ],
    [
      "bearer\\s+[a-zA-Z0-9\\-._~+/]{20,}=*",
      "<BEARER_TOKEN>"
    ],
    [
      "-----BEGIN ((?:[A-Z0-9]{1,20} ){0,4})PRIVATE KEY(?: BLOCK)?-----(?:[A-Za-z0-9+/=\\s:,.]{0,16384}-----END \\1PRIVATE KEY(?: BLOCK)?-----)?",
      "<PRIVATE_KEY>"
    ],
    [
      "([?&](?:token|access_token|id_token|refresh_token|api_key|apikey|secret|client_secret|password|passwd|pwd|passcode|sig|signature|x-amz-signature|x-amz-credential)=)(?=[^&\\s\\\"'<>#]{0,100}\\d)[^&\\s\\\"'<>#]{8,}",
      "\\1<URL_SECRET_PARAM>"
    ],
    [
      "((?<![A-Za-z0-9])(?<!page_)(?<!page-)(?:password|passwd|secret|token)[\\\"']?[ \\t]*[:=][ \\t]*[\\\"']?)(?!\\$|\\{\\{|%\\(|v?\\d+\\.\\d|[a-z_]+=\\d|[A-Za-z_][\\w.]*\\()(?![^\\s\\\"'<>,;&]{0,64}\\d{4}-\\d\\d-\\d\\d)(?=[^\\s\\\"'<>,;&]{0,100}[A-Za-z])(?=[^\\s\\\"'<>,;&]{0,100}(?:[!@#$%^*]|\\d[^\\s\\\"'<>,;&]{0,100}\\d))[^\\s\\\"'<>,;&]{8,}",
      "\\1<SECRET_VALUE>"
    ]
  ],
  "case_sensitive": [
    [
      "(\\b[A-Z0-9_]*(?:PASSWORD|PASSWD|SECRET|TOKEN)[A-Z0-9_]*\\s*=\\s*[\\\"']?)(?!(?<!')(?:\\$\\([^)\\\"'<>\\n]*\\)|\\$\\{[A-Z_][A-Z0-9_]*\\}|\\$[A-Z_][A-Z0-9_]*)(?![^\\s\\\"'<>]))(?=[^\\s\\\"']*[A-Za-z])[^\\s\\\"'<>]{6,}",
      "\\1<SECRET_VALUE>"
    ]
  ],
  "aws_bare_secret": "(?<![A-Za-z0-9/+])(?=[A-Za-z0-9/+]*[A-Z])(?=[A-Za-z0-9/+]*[a-z])(?=[A-Za-z0-9/+]*\\d)[A-Za-z0-9/+]{40}(?![A-Za-z0-9/+])",
  "aws_context_chars": 100
}
