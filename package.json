{
  "name": "@aligndottech/cli",
  "version": "0.32.0",
  "mcpName": "io.github.aligndottech/cli",
  "type": "module",
  "description": "Align CLI - capture decisions, check alignment, and manage connectors",
  "keywords": [
    "align",
    "decisions",
    "decision-graph",
    "mcp",
    "ai-agents",
    "claude-code",
    "cursor",
    "cli"
  ],
  "author": "Align (https://align.tech)",
  "license": "MIT",
  "homepage": "https://github.com/aligndottech/align-cli#readme",
  "bugs": {
    "url": "https://github.com/aligndottech/align-cli/issues"
  },
  "bin": {
    "align": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.bun.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aligndottech/connector-core": "^0.4.0",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "dotenv": "^16.4.7",
    "eventsource": "^3.0.2",
    "execa": "^9.5.2",
    "open": "^10.1.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/eventsource": "^1.1.15",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "js-yaml": "^5.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aligndottech/align-cli"
  }
}
